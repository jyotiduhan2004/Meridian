# Meridian — environment variables
# Copy to .env.local and fill in. NEVER commit real keys (.env* is gitignored).
# The app runs on STUB data if these are unset, so you can develop without any keys.

# --- LLM provider ---
# stub = canned responses (default) | gemini | grok
# In production set this to "gemini" (or "grok") + the matching key, or every
# analysis is canned. Set both Gemini + xAI keys to enable rate-limit failover.
LLM_PROVIDER=stub
GEMINI_API_KEY=
XAI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # optional override (default shown)
# XAI_MODEL=grok-2-latest         # optional override (default shown)
# XAI_VISION_MODEL=grok-2-vision-1212   # optional override (default shown)

# --- Tools ---
TAVILY_API_KEY=        # web search (Market Researcher skills)
BROWSERLESS_TOKEN=     # hosted headless browser (UX + QA skills)
GITHUB_TOKEN=          # optional: raises public-repo read rate limits
# BROWSERLESS_URL=https://production-sfo.browserless.io   # optional override (default shown)
# TOOLS=                 # set to "stub" to force offline stub tools (dev only)

# --- Storage (optional in dev; an in-memory store is used if unset) ---
# In production Supabase is required: serverless invocations don't share memory,
# so without it reports won't persist. Run supabase/schema.sql once, then set:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; bypasses RLS (the store uses this)
# SUPABASE_SECRET_KEY=              # accepted as an alternative to the service-role key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=    # reserved; not currently read by the app
# STORE=                            # set to "memory" to force the in-memory store even with Supabase set

# --- Analytics ---
NEXT_PUBLIC_NOVUS_KEY=    # client analytics id (loads the Pendo/Novus agent if set)

# --- Deployment ---
NEXT_PUBLIC_SITE_URL=     # canonical URL for OG tags / sitemap / robots (your deployed URL)
